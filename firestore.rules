rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if ownsUserPath(userId);
      allow delete: if false;

      match /conversations/{conversationId} {
        allow read, create, update, delete: if ownsUserPath(userId)
          && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId);
      }

      match /validationJobs/{jobId} {
        allow read, create, update, delete: if ownsUserPath(userId)
          && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId);
      }
    }
  }
}
